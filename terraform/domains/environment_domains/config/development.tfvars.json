{
  "hosted_zone": {
    "get-information-schools.service.gov.uk": {
      "front_door_name": "s158p01-gias-dom-fd",
      "resource_group_name": "s158p01-gias-dom-rg",
      "domains": [
        "dev"
      ],
      "cached_paths": [
        "/assets/*"
      ],
      "environment_short": "dv",
      "origin_hostname": "get-information-about-schools-development.test.teacherservices.cloud"
    }
  },
  "rate_limit": [
    {
      "agent": "giast1dvRateLimit",
      "priority": "1",
      "type": "RateLimitRule",
      "duration": 5,
      "limit": 1000,
      "match_variable": "RequestHeader",
      "selector": "Host",
      "operator": "GreaterThanOrEqual",
      "match_values": ["0"]
    },
    {
      "agent": "extractDownloads",
      "priority": "3",
      "type": "MatchRule",
      "match_variable": "PostArgs",
      "selector": "path",
      "operator": "Equal",
      "match_values": [
        "https://app-api-t1dv-edubase.azurewebsites.net/edubase/downloads/File.xhtml",
        "https://app-api-t1dv-edubase.azurewebsites.net/edubase/downloads/downloadSearchExtract.xhtml",
        "https://app-api-t1dv-edubase.azurewebsites.net/edubase/downloads/downloadScheduledExtract.xhtml"
      ]
    },
    {
      "agent": "giasFAQsGlossaryEdit",
      "priority": "4",
      "type": "MatchRule",
      "match_variable": "RequestUri",
      "operator": "Contains",
      "match_values": [
        "https://www.dev.get-information-schools.service.gov.uk/Faq/Create",
        "https://www.dev.get-information-schools.service.gov.uk/glossary/Create",
        "https://dev.get-information-schools.service.gov.uk/Faq/Create",
        "https://dev.get-information-schools.service.gov.uk/glossary/Create"
      ]
    },
    {
      "agent": "bulkUpdate",
      "priority": "6",
      "type": "MatchRule",
      "match_variable": "RequestUri",
      "operator": "Contains",
      "match_values": [
        "https://dev.get-information-schools.service.gov.uk:443/Establishments/BulkUpdate",
        "https://dev.get-information-schools.service.gov.uk:443/Downloads/Download/Extract",
        "https://www.dev.get-information-schools.service.gov.uk:443/Downloads/Download/Extract",
        "https://www.dev.get-information-schools.service.gov.uk:443/Establishments/BulkUpdate",
        "https://dev.get-information-schools.service.gov.uk/Downloads/Download/Extract"
      ]
    },
    {
      "agent": "addNews",
      "priority": "7",
      "type": "MatchRule",
      "match_variable": "RequestUri",
      "operator": "Contains",
      "match_values": [
        "https://www.dev.get-information-schools.service.gov.uk:443/News/Article/",
        "https://dev.get-information-schools.service.gov.uk:443/News/Article/"
      ]
    }
  ],
  "rate_limit_max": 300,
  "allow_aks": true,
  "block_ip": true
}
